# =====================================================================
# CivicFix Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Google Maps & Street View API Configuration
# ---------------------------------------------------------------------
# To stream interactive 360° Street View panoramas via Google Maps Embed API
# and query Street View Image Metadata, create an API key in Google Cloud Console:
# https://console.cloud.google.com/
#
# REQUIRED GOOGLE CLOUD APIS TO ENABLE:
# 1. "Maps Embed API" (Enables embedded Street View mode via iframe)
# 2. "Street View Static API" (Enables metadata verification & static panorama tiles)
#
# BILLING REQUIREMENT:
# Google Cloud requires an active billing account linked to your project.
# The Maps Embed API in Street View mode offers generous free tier usage.
#
# SECURE KEY RESTRICTIONS (Best Practices):
# - Set Application Restrictions: "Web sites (HTTP referrers)"
# - Add allowed referrers:
#     http://localhost:3000/*
#     https://your-production-domain.vercel.app/*
# - Set API Restrictions: Restrict key usage specifically to:
#     - "Maps Embed API"
#     - "Street View Static API"
#
# Client-side exposed API key for Google Maps Embed API Street View mode:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-side optional key (falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY if omitted):
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ---------------------------------------------------------------------
# Google Gemini API Key (Optional for Live Multimodal Vision Analysis)
# ---------------------------------------------------------------------
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# Supabase Authentication & Database (Optional)
# ---------------------------------------------------------------------
# If omitted, CivicFix operates automatically on the built-in cryptographic
# Web Crypto SHA-256 session and password-hashing engine.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ---------------------------------------------------------------------
# Municipal Admin Invite Key (Prevents citizen privilege escalation)
# ---------------------------------------------------------------------
ADMIN_INVITE_CODE=CIVIC_ADMIN_2026
